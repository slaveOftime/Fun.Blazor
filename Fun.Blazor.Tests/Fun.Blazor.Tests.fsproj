<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<GenerateProgramFile>false</GenerateProgramFile>
		<TestingPlatformCommandLineArguments>--coverage --coverage-output-format cobertura</TestingPlatformCommandLineArguments>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="Infrastructure/Utils.fs" />
		<Compile Include="Core/DITests.fs" />
		<Compile Include="Core/I18nTests.fs" />
		<Compile Include="Core/QueryBuilderTests.fs" />
		<Compile Include="Components/AdaptiveTests.fs" />
		<Compile Include="Components/AdaptiveFormTests.fs" />
		<Compile Include="Components/HookTests.fs" />
		<Compile Include="Components/RouterTests.fs" />
		<Compile Include="Rendering/CascadingValueTests.fs" />
		<Compile Include="Rendering/DomTests.fs" />
		<Compile Include="Rendering/PostRenderFragmentTests.fs" />
		<Compile Include="Rendering/StyleTests.fs" />
		<Compile Include="Integration/ServerTests.fs" />
		<Compile Include="Integration/HtmxTests.fs" />
		<Compile Include="Templates/TemplateTests.fs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="bunit" Version="2.9.0" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Bindings\Fun.Blazor.Microsoft.Web\Fun.Blazor.Microsoft.Web.fsproj" />
		<ProjectReference Include="..\Bindings\Fun.Blazor.MudBlazor\Fun.Blazor.MudBlazor.fsproj" />
		<ProjectReference Include="..\Fun.Blazor.HtmlTemplate\Fun.Blazor.HtmlTemplate.fsproj" />
		<ProjectReference Include="..\Fun.Blazor.Server\Fun.Blazor.Server.fsproj" />
		<ProjectReference Include="..\Fun.Blazor\Fun.Blazor.fsproj" />
		<ProjectReference Include="..\Fun.Htmx\Fun.Htmx.fsproj" />
	</ItemGroup>
</Project>